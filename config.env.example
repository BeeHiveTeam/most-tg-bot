# most-tg-bot configuration. Copy to config.env, chmod 600, fill in on the server.
# Never paste real tokens into a chat or a commit — enter them with `read -s`.

# Telegram bot token from @BotFather
TG_TOKEN=

# Chat to alert. Your own user id for a private bot, or a -100… group id.
TG_CHAT_ID=

# GitHub personal access token, classic or fine-grained, PUBLIC READ ONLY.
# Optional but strongly recommended: without it GitHub allows 60 requests/hour, which forces
# a 10-minute poll across seven repos — too slow when issues are taken in minutes. With it the
# ceiling is 5000/hour and the poll drops to 60s. The token needs no scopes at all for public
# repositories; do not grant repo write.
GH_TOKEN=

# Pull requests to watch, "owner/repo#number", comma-separated. Leave empty and the bot
# follows every open PR of yours in the pool, found from MY_LOGIN — which stays correct as
# your PRs come and go. Set it only to pin specific ones.
WATCH_PR=

# Seconds between polls. Leave unset: 60 with a token, 600 without.
# POLL_INTERVAL=60

# Comma-separated override of the pool. Leave unset to use the built-in list.
# REPOS=portdeveloper/nad-agent,portdeveloper/monad-monitor

# Your GitHub login, so an issue assigned to you still reads as yours.
MY_LOGIN=

# UI language: en (default), ru, or de. Also switchable at runtime with the 🌐 button or /lang.
LANG=en
